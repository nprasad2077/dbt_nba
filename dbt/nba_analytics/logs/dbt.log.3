      cast(  
           q1_points
             
           as INTEGER) as points_scored

    from nba_analytics.analytics_dev_staging.stg_line_scores

    union all
    select
        game_id,
        team,
        total_points,
        first_half_points,
        second_half_points,
        regulation_points,
        overtime_points,
        had_ot1,
        had_ot2,
        had_ot3,

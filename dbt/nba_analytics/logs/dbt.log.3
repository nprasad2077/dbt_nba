  create  table nba_analytics.analytics_dev_marts.dim_dates__dbt_tmp
  
  
    as
  
  (
    

-- Get the min and max game dates from our source dataWITH date_spine AS (
    -- Use PostgreSQL's native function to generate a date series
    SELECT CAST(generated_date AS DATE) as date_day
    FROM generate_series(
        '2002-10-29'::date,
        '2025-11-03'::date,
        '1 day'::interval
    ) AS generated_date
)

SELECT
    -- Surrogate Key: An integer key in YYYYMMDD format
    CAST(to_char(date_day, 'YYYYMMDD') AS INTEGER) AS date_key,
    
    -- Date Attributes (using the correct PostgreSQL functions)
    date_day AS full_date,
    EXTRACT(YEAR FROM date_day) AS year,
    EXTRACT(QUARTER FROM date_day) AS quarter_of_year,
    EXTRACT(MONTH FROM date_day) AS month_of_year,
    TRIM(to_char(date_day, 'Month')) AS month_name,
    EXTRACT(DAY FROM date_day) AS day_of_month,
    EXTRACT(ISODOW FROM date_day) AS day_of_week, -- 1=Monday, 7=Sunday
    TRIM(to_char(date_day, 'Day')) AS day_of_week_name,
    EXTRACT(DOY FROM date_day) AS day_of_year,
    EXTRACT(WEEK FROM date_day) AS week_of_year,
    CASE 
        WHEN EXTRACT(ISODOW FROM date_day) IN (6, 7) THEN true
        ELSE false 
    END AS is_weekend

FROM date_spine
ORDER BY full_date
  );
  

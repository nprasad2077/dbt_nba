  create  table nba_analytics.analytics_dev_marts.fct_quarter_scoring
  
  
    as
  
  (
    

WITH line_scores AS (
    SELECT * FROM nba_analytics.analytics_dev_staging.stg_line_scores
),

games AS (
    SELECT
        g.game_id,
        g.game_date,
        g.season_start_year,
        g.is_playoff,
        g.arena AS arena_name,
        g.arena_city,
        home_map.team_abbr AS home_team_abbr,
        visitor_map.team_abbr AS visitor_team_abbr
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched g
    LEFT JOIN nba_analytics.analytics_dev.team_mappings AS home_map 
        ON g.home_team = home_map.full_name
    LEFT JOIN nba_analytics.analytics_dev.team_mappings AS visitor_map 
        ON g.visitor_team = visitor_map.full_name
),

team_conformed AS (
    SELECT
        ls.*,
        map.team_abbr AS team_conformed,
        g.game_date,
        g.season_start_year,
        g.is_playoff,
        g.arena_name,
        g.arena_city,
        g.home_team_abbr,
        g.visitor_team_abbr
    FROM line_scores AS ls
    LEFT JOIN nba_analytics.analytics_dev.team_abbreviation_mappings AS map
        ON ls.team = map.source_abbr
    LEFT JOIN games AS g
        ON ls.game_id = g.game_id
),

unpivoted AS (
    -- Unpivot quarters to create one row per quarter per team
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'Q1' AS quarter,
        1 AS quarter_number,
        q1_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    
    UNION ALL
    
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'Q2' AS quarter,
        2 AS quarter_number,
        q2_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    
    UNION ALL
    
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'Q3' AS quarter,
        3 AS quarter_number,
        q3_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    
    UNION ALL
    
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'Q4' AS quarter,
        4 AS quarter_number,
        q4_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    
    UNION ALL
    
    -- Include overtime periods only if they occurred
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'OT1' AS quarter,
        5 AS quarter_number,
        ot1_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    WHERE ot1_points > 0
    
    UNION ALL
    
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'OT2' AS quarter,
        6 AS quarter_number,
        ot2_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    WHERE ot2_points > 0
    
    UNION ALL
    
    SELECT
        game_id,
        team_conformed AS team,
        game_date,
        season_start_year,
        is_playoff,
        arena_name,
        arena_city,
        home_team_abbr,
        visitor_team_abbr,
        'OT3' AS quarter,
        7 AS quarter_number,
        ot3_points AS points,
        first_half_points,
        second_half_points,
        regulation_points,
        total_points
    FROM team_conformed
    WHERE ot3_points > 0
),

with_opponent AS (
    SELECT
        u.*,
        opp.points AS opponent_points,
        u.points - opp.points AS quarter_differential,
        CASE
            WHEN u.team = u.home_team_abbr THEN u.visitor_team_abbr
            ELSE u.home_team_abbr
        END AS opponent_team
    FROM unpivoted AS u
    LEFT JOIN unpivoted AS opp
        ON u.game_id = opp.game_id
        AND u.quarter = opp.quarter
        AND u.team != opp.team
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(wo.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(wo.team as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(wo.quarter as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS quarter_score_key,

        -- Foreign Keys
        t.team_key,
        d.date_key,
        s.season_key,
        a.arena_key,
        g.game_key,
        opp.team_key AS opponent_key,

        -- Degenerate Dimensions
        wo.game_id,
        wo.quarter,
        wo.quarter_number,

        -- Context
        (wo.team = wo.home_team_abbr) AS is_home_team,
        wo.is_playoff,
        
        -- Measures
        wo.points AS quarter_points,
        wo.opponent_points AS opponent_quarter_points,
        wo.quarter_differential,
        
        -- Running totals (would need window functions for true running totals)
        CASE
            WHEN wo.quarter_number = 1 THEN wo.points
            WHEN wo.quarter_number = 2 THEN wo.first_half_points
            WHEN wo.quarter_number = 4 THEN wo.regulation_points
            ELSE wo.total_points -- For OT quarters
        END AS points_through_quarter,
        
        -- Quarter performance indicators
        CASE
            WHEN wo.points >= 35 THEN 'Explosive'
            WHEN wo.points >= 30 THEN 'High Scoring'
            WHEN wo.points >= 25 THEN 'Above Average'
            WHEN wo.points >= 20 THEN 'Average'
            WHEN wo.points >= 15 THEN 'Below Average'
            ELSE 'Poor'
        END AS quarter_performance,
        
        -- Momentum indicators
        CASE
            WHEN wo.quarter_differential >= 10 THEN 'Dominant Quarter'
            WHEN wo.quarter_differential >= 5 THEN 'Won Quarter'
            WHEN wo.quarter_differential >= -4 THEN 'Close Quarter'
            WHEN wo.quarter_differential >= -9 THEN 'Lost Quarter'
            ELSE 'Dominated Quarter'
        END AS quarter_outcome,
        
        -- Special quarter flags
        CASE
            WHEN wo.quarter IN ('Q1', 'Q3') THEN TRUE
            ELSE FALSE
        END AS is_start_of_half,
        
        CASE
            WHEN wo.quarter IN ('Q2', 'Q4') THEN TRUE
            ELSE FALSE
        END AS is_end_of_half,
        
        CASE
            WHEN wo.quarter LIKE 'OT%' THEN TRUE
            ELSE FALSE
        END AS is_overtime_period,

        -- Game Date for partitioning
        CAST(wo.game_date AS DATE) AS game_date

    FROM with_opponent AS wo
    
    -- Join to dimension tables
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS t
        ON wo.team = t.team_abbr
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS opp
        ON wo.opponent_team = opp.team_abbr
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(wo.game_date AS DATE) = d.full_date
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON wo.season_start_year = s.season_start_year
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON wo.arena_name = a.arena_name AND wo.arena_city = a.arena_city
        
    LEFT JOIN nba_analytics.analytics_dev_marts.fct_game_results AS g
        ON wo.game_id = g.game_id

    
)

SELECT * FROM final
  );
  
  

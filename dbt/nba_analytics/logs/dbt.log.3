  create  table nba_analytics.analytics_dev_marts.fct_player_game_stats__dbt_tmp
  
  
    as
  
  (
    

WITH player_performance AS (
    SELECT * FROM nba_analytics.analytics_dev_intermediate.int_player_performance
),

game_details AS (
    SELECT
        game_id,
        arena AS arena_name,
        arena_city
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(pp.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(pp.player_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS player_game_key,

        -- Foreign Keys
        p.player_key,
        t.team_key,
        d.date_key,
        s.season_key,
        a.arena_key,
        
        -- Junk Dimension
        arch.archetype_key,

        -- Degenerate Dimension
        pp.game_id,

        -- Measures from player_performance
        pp.minutes_played,
        pp.points,
        pp.assists,
        pp.total_rebounds,
        pp.steals,
        pp.blocks,
        pp.turnovers,
        pp.plus_minus,
        pp.net_rating,
        pp.box_plus_minus,
        pp.field_goals_made,
        pp.field_goals_attempted,
        pp.three_pointers_made,
        pp.three_pointers_attempted,
        pp.true_shooting_pct,
        pp.effective_fg_pct,
        pp.usage_pct,
        pp.offensive_rating,
        pp.defensive_rating,

        -- Game Date for partitioning
        CAST(pp.game_date AS DATE) AS game_date

    FROM player_performance AS pp

    LEFT JOIN game_details AS gd
        ON pp.game_id = gd.game_id

    LEFT JOIN nba_analytics.analytics_dev_marts.dim_player_game_archetypes AS arch
        ON pp.usage_tier = arch.usage_tier
        AND pp.impact_tier = arch.impact_tier
        AND pp.shooting_efficiency_tier = arch.shooting_efficiency_tier
        AND pp.minutes_based_role = arch.minutes_based_role
        AND pp.is_double_double = arch.is_double_double
        AND pp.is_triple_double = arch.is_triple_double
        AND pp.is_versatile = arch.is_versatile
        AND pp.is_defensive_specialist = arch.is_defensive_specialist
        AND pp.is_three_and_d = arch.is_three_and_d
    
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_players AS p
        ON pp.player_id = p.player_id
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS t
        ON pp.team = t.team_abbr
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(pp.game_date AS DATE) = d.full_date
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON pp.season_start_year = s.season_start_year
    -- This join is now robust and correct
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON gd.arena_name = a.arena_name AND gd.arena_city = a.arena_city

    
)

SELECT * FROM final
  );
  
  
[0m05:49:26.307407 [debug] [Thread-1 (]: On model.nba_analytics.fct_game_results: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.fct_game_results"} */

      
  
    

  create  table nba_analytics.analytics_dev_marts.fct_game_results__dbt_tmp
  
  
    as
  
  (
    

WITH game_enriched AS (
    SELECT * FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(ge.game_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS game_key,

        -- Foreign Keys
        d.date_key,
        s.season_key,
        a.arena_key,
        ht.team_key AS home_team_key,
        vt.team_key AS visitor_team_key,
        wt.team_key AS winning_team_key,

        -- Degenerate Dimension
        ge.game_id,

        -- Game Context
        ge.is_playoff,
        ge.is_overtime,
        
        -- Score Information
        ge.home_points,
        ge.visitor_points,
        ge.point_differential,
        ge.total_points,
        
        -- Home Team Performance Metrics
        ge.home_offensive_rating,
        ge.home_defensive_rating,
        ge.home_net_rating,
        ge.home_pace,
        ge.home_effective_fg_pct,
        ge.home_turnover_rate,
        
        -- Visitor Team Performance Metrics
        ge.visitor_offensive_rating,
        ge.visitor_defensive_rating,
        ge.visitor_net_rating,
        ge.visitor_pace,
        ge.visitor_effective_fg_pct,
        ge.visitor_turnover_rate,
        
        -- Matchup Metrics
        ge.matchup_pace,
        ge.home_off_vs_visitor_def_advantage,
        ge.visitor_off_vs_home_def_advantage,
        
        -- Derived Metrics
        CASE 
            WHEN ge.home_points > ge.visitor_points THEN 1
            ELSE 0
        END AS home_team_won,
        
        -- Performance differentials
        ge.home_offensive_rating - ge.visitor_offensive_rating AS offensive_rating_differential,
        ge.home_defensive_rating - ge.visitor_defensive_rating AS defensive_rating_differential,
        ge.home_effective_fg_pct - ge.visitor_effective_fg_pct AS effective_fg_pct_differential,
        
        -- Game competitiveness metrics
        CASE
            WHEN ge.point_differential <= 5 THEN 'Very Close'
            WHEN ge.point_differential <= 10 THEN 'Close'
            WHEN ge.point_differential <= 20 THEN 'Comfortable'
            ELSE 'Blowout'
        END AS game_competitiveness,
        
        -- Upset indicator (would need betting lines for true upset, using net rating as proxy)
        CASE
            WHEN ge.home_points > ge.visitor_points AND ge.home_net_rating < ge.visitor_net_rating - 5 THEN TRUE
            WHEN ge.visitor_points > ge.home_points AND ge.visitor_net_rating < ge.home_net_rating - 5 THEN TRUE
            ELSE FALSE
        END AS potential_upset,

        -- Game Date for partitioning
        CAST(ge.game_date AS DATE) AS game_date

    FROM game_enriched AS ge
    
    -- Join to dimension tables
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(ge.game_date AS DATE) = d.full_date
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON ge.season_start_year = s.season_start_year
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON ge.arena = a.arena_name AND ge.arena_city = a.arena_city
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS ht
        ON ge.home_team = ht.team_abbr
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS vt
        ON ge.visitor_team = vt.team_abbr
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS wt
        ON ge.winning_team = wt.team_abbr

    
)

SELECT * FROM final
  );
  
  

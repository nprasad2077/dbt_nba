[0m03:59:40.274868 [debug] [Thread-1 (]: On model.nba_analytics.dim_arenas: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_arenas"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_arenas__dbt_tmp
  
  
    as
  
  (
    

WITH all_arenas AS (
    -- Get a unique list of all arenas from the enriched games model
    SELECT DISTINCT
        arena
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
    -- Ensure we only create dimension entries for arenas that have a name
    WHERE arena IS NOT NULL AND arena != ''
)

SELECT
    -- Surrogate Key: A unique key based on the arena name
    md5(cast(coalesce(cast(arena as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS arena_key,

    -- Arena Attributes
    arena AS arena_name

    -- We don't have city information available in this source, so we'll omit it for now.
    -- If we get a new source with arena cities, we could enrich this dimension later.

FROM all_arenas
ORDER BY arena_name
  );
  

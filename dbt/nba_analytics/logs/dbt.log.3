[0m04:22:22.976216 [debug] [Thread-1 (]: On model.nba_analytics.fct_player_game_stats: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.fct_player_game_stats"} */

  
    

  create  table nba_analytics.analytics_dev_marts.fct_player_game_stats__dbt_tmp
  
  
    as
  
  (
    

WITH player_stats AS (
    SELECT *
    FROM nba_analytics.analytics_dev_staging.stg_player_game_basic_stats
),

games AS (
    -- We need game-level info to link to arenas, seasons, and dates
    SELECT
        game_id,
        season_start_year,
        arena_name,
        arena_city,
        CAST(game_date AS DATE) AS game_date -- Cast to DATE for joining to dim_dates
    FROM nba_analytics.analytics_dev_staging.stg_games
),

-- Now, let's get the surrogate keys from each dimension table
dim_players AS (
    SELECT player_key, player_id
    FROM nba_analytics.analytics_dev_marts.dim_players
),

dim_teams AS (
    SELECT team_key, team_id
    FROM nba_analytics.analytics_dev_marts.dim_teams
),

dim_seasons AS (
    SELECT season_key, season_start_year
    FROM nba_analytics.analytics_dev_marts.dim_seasons
),

dim_arenas AS (
    SELECT arena_key, arena_name, arena_city
    FROM nba_analytics.analytics_dev_marts.dim_arenas
),

dim_dates AS (
    SELECT date_key, full_date
    FROM nba_analytics.analytics_dev_marts.dim_dates
)

SELECT
    -- Surrogate Key for the fact table itself
    md5(cast(coalesce(cast(player_stats.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(player_stats.player_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS player_game_key,

    -- Foreign Keys from Dimension Tables
    COALESCE(dp.player_key, -1) AS player_key,
    COALESCE(dt.team_key, -1) AS team_key,
    COALESCE(dd.date_key, -1) AS date_key,
    COALESCE(da.arena_key, -1) AS arena_key,
    COALESCE(ds.season_key, -1) AS season_key,

    -- Degenerate Dimension
    player_stats.game_id,

    -- Player Performance Measures
    player_stats.points,
    player_stats.rebounds,
    player_stats.assists,
    player_stats.steals,
    player_stats.blocks,
    player_stats.turnovers,
    player_stats.field_goals_made,
    player_stats.field_goals_attempted,
    player_stats.three_pointers_made,
    player_stats.three_pointers_attempted,
    player_stats.free_throws_made,
    player_stats.free_throws_attempted,
    player_stats.personal_fouls,
    player_stats.plus_minus

FROM player_stats
LEFT JOIN games ON player_stats.game_id = games.game_id
LEFT JOIN dim_players AS dp ON player_stats.player_id = dp.player_id
LEFT JOIN dim_teams AS dt ON player_stats.team_id = dt.team_id
LEFT JOIN dim_dates AS dd ON games.game_date = dd.full_date
LEFT JOIN dim_seasons AS ds ON games.season_start_year = ds.season_start_year
LEFT JOIN dim_arenas AS da ON games.arena_name = da.arena_name AND games.arena_city = da.arena_city
  );
  

  create  table nba_analytics.analytics_dev_marts.dim_arenas__dbt_tmp
  
  
    as
  
  (
    

WITH all_arenas AS (
    -- Get a unique list of all arenas and their cities from the enriched games model
    SELECT DISTINCT
        arena_name,
        arena_city
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
    -- Ensure we only create dimension entries for arenas that have a name
    WHERE arena_name IS NOT NULL AND arena_name != ''
)

SELECT
    -- Surrogate Key: A unique key based on the combination of arena and city
    md5(cast(coalesce(cast(arena_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(arena_city as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS arena_key,

    -- Arena Attributes
    arena_name,
    arena_city

FROM all_arenas
ORDER BY arena_name, arena_city
  );
  

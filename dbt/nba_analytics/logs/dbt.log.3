[0m22:43:52.458958 [debug] [Thread-2 (]: On model.nba_analytics.dim_teams: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_teams"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_teams__dbt_tmp
  
  
    as
  
  (
    

WITH team_mappings AS (
    SELECT 
        team_abbr,
        full_name
    FROM nba_analytics.analytics_dev_seeds.team_mappings
)

SELECT
    -- Surrogate Key
    md5(cast(coalesce(cast(team_abbr as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS team_key,

    -- Team Identifiers
    team_abbr,
    full_name AS team_full_name

    -- We can add more dimensional attributes here in the future
    -- e.g., conference, division, city, etc.

FROM team_mappings
ORDER BY team_abbr
  );
  

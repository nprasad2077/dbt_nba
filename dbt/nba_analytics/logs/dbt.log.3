  create  table nba_analytics.analytics_dev_marts.dim_arenas__dbt_tmp
  
  
    as
  
  (
    

WITH source AS (
    SELECT
        arena_name,
        city,
        state_or_country,
        location
    FROM nba_analytics.analytics_dev_seeds.arena_mappings
)

SELECT
    -- Surrogate Key: A unique key based on the combination of arena and city from our seed file
    md5(cast(coalesce(cast(arena_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS arena_key,

    -- Arena Attributes, renamed for clarity
    arena_name,
    city AS arena_city,
    state_or_country AS arena_state_or_country,
    location AS arena_location

FROM source
ORDER BY arena_name, arena_city
  );
  
[0m05:25:31.622267 [debug] [Thread-4 (]: On model.nba_analytics.dim_players: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_players"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_players__dbt_tmp
  
  
    as
  
  (
    

WITH player_game_stats AS (
    SELECT
        stats.player_id,
        stats.player_name,
        games.game_date,
        -- Rank each player's name records by game date, with the most recent being #1
        ROW_NUMBER() OVER (PARTITION BY stats.player_id ORDER BY games.game_date DESC) as rn
    FROM nba_analytics.analytics_dev_staging.stg_player_game_basic_stats AS stats
    LEFT JOIN nba_analytics.analytics_dev_staging.stg_games AS games
        ON stats.game_id = games.game_id
)

SELECT
    -- Surrogate Key: A unique key for the player based on their ID
    md5(cast(coalesce(cast(player_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS player_key,

    -- Player Attributes
    player_id,
    player_name

FROM player_game_stats
-- Filter to only the most recent record for each player
WHERE rn = 1
ORDER BY player_name
  );
  

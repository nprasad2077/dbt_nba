  create  table nba_analytics.analytics_dev_intermediate.int_games_enriched__dbt_tmp
  
  
    as
  
  (
    

WITH games AS (
    SELECT
        g.*,
        -- Use the abbreviation mappings for consistency with other intermediate models
        home_map.team_abbr AS home_team_conformed,
        visitor_map.team_abbr AS visitor_team_conformed,
        winning_map.team_abbr AS winning_team_conformed
    FROM nba_analytics.analytics_dev_staging.stg_games AS g
    -- This join is more robust than joining on full_name
    LEFT JOIN nba_analytics.analytics_dev.team_abbreviation_mappings AS home_map ON g.home_team = home_map.source_abbr
    LEFT JOIN nba_analytics.analytics_dev.team_abbreviation_mappings AS visitor_map ON g.visitor_team = visitor_map.source_abbr
    LEFT JOIN nba_analytics.analytics_dev.team_abbreviation_mappings AS winning_map ON g.winning_team = winning_map.source_abbr
),

arena_locations AS (
    SELECT
        arena_name,
        city AS arena_city
    FROM nba_analytics.analytics_dev.arena_mappings
    -- Handle cases where an arena name might exist in multiple cities (unlikely but robust)
    QUALIFY ROW_NUMBER() OVER (PARTITION BY arena_name ORDER BY city) = 1
),

team_performance AS (
    SELECT *
    FROM nba_analytics.analytics_dev_intermediate.int_team_performance
),

final AS (
    SELECT
        -- Core Game Details
        g.game_id,
        g.game_date,
        g.season_start_year,
        g.is_playoff,
        g.arena,
        al.arena_city, -- <<< THE NEWLY ADDED CITY
        
        -- Team Identifiers (using conformed abbreviations)
        g.home_team_conformed AS home_team,
        g.visitor_team_conformed AS visitor_team,
        g.winning_team_conformed AS winning_team,
        
        -- Final Score & Outcome
        g.home_points,
        g.visitor_points,
        g.point_differential,
        g.total_points,
        g.is_overtime,
        
        -- Home Team Performance (prefixed with 'home_')
        home_stats.offensive_rating AS home_offensive_rating,
        home_stats.defensive_rating AS home_defensive_rating,
        home_stats.net_rating AS home_net_rating,
        home_stats.pace AS home_pace,
        home_stats.effective_fg_pct AS home_effective_fg_pct,
        home_stats.turnover_rate AS home_turnover_rate,
        home_stats.offensive_tier AS home_offensive_tier,
        home_stats.defensive_tier AS home_defensive_tier,
        
        -- Visitor Team Performance (prefixed with 'visitor_')
        visitor_stats.offensive_rating AS visitor_offensive_rating,
        visitor_stats.defensive_rating AS visitor_defensive_rating,
        visitor_stats.net_rating AS visitor_net_rating,
        visitor_stats.pace AS visitor_pace,
        visitor_stats.effective_fg_pct AS visitor_effective_fg_pct,
        visitor_stats.turnover_rate AS visitor_turnover_rate,
        visitor_stats.offensive_tier AS visitor_offensive_tier,
        visitor_stats.defensive_tier AS visitor_defensive_tier,

        -- Calculated Matchup Metrics
        (home_stats.pace + visitor_stats.pace) / 2 AS matchup_pace,
        home_stats.offensive_rating - visitor_stats.defensive_rating AS home_off_vs_visitor_def_advantage,
        visitor_stats.offensive_rating - home_stats.defensive_rating AS visitor_off_vs_home_def_advantage

    FROM games g
    
    -- Join to get arena city
    LEFT JOIN arena_locations al
        ON g.arena = al.arena_name

    -- Join for home team stats using the conformed abbreviation
    LEFT JOIN team_performance AS home_stats
        ON g.game_id = home_stats.game_id
        AND g.home_team_conformed = home_stats.team
        
    -- Join for visitor team stats using the conformed abbreviation
    LEFT JOIN team_performance AS visitor_stats
        ON g.game_id = visitor_stats.game_id
        AND g.visitor_team_conformed = visitor_stats.team
)

SELECT * FROM final
  );
  

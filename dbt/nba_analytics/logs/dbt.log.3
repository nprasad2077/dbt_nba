        END AS game_result,
        CASE
            WHEN b.team_conformed = g.home_team_abbr THEN g.visitor_team_abbr
            ELSE g.home_team_abbr
        END AS opponent_team,

        -- Core Performance
        b.points,
        a.offensive_rating,
        a.defensive_rating,
        a.net_rating,

        -- Pace & Four Factors

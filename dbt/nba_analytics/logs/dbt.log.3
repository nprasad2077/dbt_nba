  create  table nba_analytics.analytics_dev_marts.dim_seasons__dbt_tmp
  
  
    as
  
  (
    

WITH all_seasons AS (
    -- Get a unique list of all seasons from the enriched games model
    SELECT DISTINCT 
        season_start_year
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
)

SELECT
    -- Surrogate Key: A durable, unique key for the season
    md5(cast(coalesce(cast(season_start_year as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS season_key,

    -- Season Attributes
    season_start_year,
    
    -- Create a user-friendly display name, e.g., '2022-23'
    season_start_year || '-' || SUBSTR(CAST(season_start_year + 1 AS VARCHAR), 3, 2) AS season_display

FROM all_seasons
ORDER BY season_start_year
  );
  

  create  table nba_analytics.analytics_dev_marts.fct_player_game_stats__dbt_tmp
  
  
    as
  
  (
    

WITH player_performance AS (
    SELECT * FROM nba_analytics.analytics_dev_intermediate.int_player_performance
),

game_details AS (
    SELECT
        game_id,
        arena AS arena_name,
        arena_city
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(pp.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(pp.player_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS player_game_key,

        -- Foreign Keys
        p.player_key,
        t.team_key,
        d.date_key,
        s.season_key,
        a.arena_key,
        
        -- Junk Dimension
        arch.archetype_key,

        -- Degenerate Dimension
        pp.game_id,

        -- Measures from player_performance
        pp.minutes_played,
        pp.points,
        pp.assists,
        pp.total_rebounds,
        pp.steals,
        pp.blocks,
        pp.turnovers,
        pp.plus_minus,
        pp.net_rating,
        pp.box_plus_minus,
        pp.field_goals_made,
        pp.field_goals_attempted,
        pp.three_pointers_made,
        pp.three_pointers_attempted,
        pp.true_shooting_pct,
        pp.effective_fg_pct,
        pp.usage_pct,
        pp.offensive_rating,
        pp.defensive_rating,

        -- Game Date for partitioning
        CAST(pp.game_date AS DATE) AS game_date

    FROM player_performance AS pp

    LEFT JOIN game_details AS gd
        ON pp.game_id = gd.game_id

    LEFT JOIN nba_analytics.analytics_dev_marts.dim_player_game_archetypes AS arch
        ON pp.usage_tier = arch.usage_tier
        AND pp.impact_tier = arch.impact_tier
        AND pp.shooting_efficiency_tier = arch.shooting_efficiency_tier
        AND pp.minutes_based_role = arch.minutes_based_role
        AND pp.is_double_double = arch.is_double_double
        AND pp.is_triple_double = arch.is_triple_double
        AND pp.is_versatile = arch.is_versatile
        AND pp.is_defensive_specialist = arch.is_defensive_specialist
        AND pp.is_three_and_d = arch.is_three_and_d
    
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_players AS p
        ON pp.player_id = p.player_id
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS t
        ON pp.team = t.team_abbr
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(pp.game_date AS DATE) = d.full_date
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON pp.season_start_year = s.season_start_year
    -- This join is now robust and correct
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON gd.arena_name = a.arena_name AND gd.arena_city = a.arena_city

    
)

SELECT * FROM final
  );
  
  
[0m03:33:28.936763 [debug] [Thread-2 (]: On model.nba_analytics.fct_team_game_stats: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.fct_team_game_stats"} */

      
  
    

  create  table nba_analytics.analytics_dev_marts.fct_team_game_stats__dbt_tmp
  
  
    as
  
  (
    

WITH team_performance AS (
    SELECT *
    FROM nba_analytics.analytics_dev_intermediate.int_team_performance
),

game_details AS (
    SELECT
        game_id,
        game_date,
        season_start_year,
        home_team,
        visitor_team,
        arena AS arena_name,
        arena_city
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(tp.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(tp.team as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS team_game_key,

        -- Foreign Keys from Dimensions
        t.team_key,
        d.date_key,
        s.season_key,
        a.arena_key,
        opp.team_key AS opponent_key, -- Key for the opposing team

        -- Degenerate Dimension
        tp.game_id,

        -- Game Details
        -- BGN CHANGE: Deriving is_home_team directly from game_details
        (tp.team = gd.home_team) AS is_home_team,
        -- END CHANGE

        -- Measures from team_performance
        tp.points,
        tp.offensive_rating,
        tp.defensive_rating,
        tp.net_rating,
        tp.pace,
        tp.effective_fg_pct,
        tp.turnover_rate,
        tp.offensive_tier,
        tp.defensive_tier,

        -- Game Date for partitioning / incremental logic
        CAST(gd.game_date AS DATE) AS game_date

    FROM team_performance AS tp

    LEFT JOIN game_details AS gd
        ON tp.game_id = gd.game_id
    
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS t
        ON tp.team = t.team_abbr
    
    -- This join identifies the opponent's abbreviation for the opponent_key lookup
    -- BGN CHANGE: Corrected logic to derive opponent without the missing flag
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS opp
        ON CASE
            WHEN tp.team = gd.home_team THEN gd.visitor_team
            ELSE gd.home_team
        END = opp.team_abbr
    -- END CHANGE
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(gd.game_date AS DATE) = d.full_date
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON gd.season_start_year = s.season_start_year
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON gd.arena_name = a.arena_name AND gd.arena_city = a.arena_city

    
)

SELECT * FROM final
  );
  
  

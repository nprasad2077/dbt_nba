  create  table nba_analytics.analytics_dev_marts.fct_quarter_scoring__dbt_tmp
  
  
    as
  
  (
    

WITH games AS (
    SELECT
        game_id,
        game_date,
        season_start_year
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
    
),

unpivoted_scores AS (
    -- This CTE unpivots the raw line scores data. The team abbreviations are still unconformed here.
    select
        game_id,
        team,
        total_points,
        first_half_points,
        second_half_points,
        regulation_points,
        overtime_points,
        had_ot1,
        had_ot2,
        had_ot3,
        q2_momentum,
        q3_momentum,
        q4_momentum,
        max_quarter_score,

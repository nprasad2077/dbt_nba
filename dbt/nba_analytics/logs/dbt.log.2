[0m05:25:10.069277 [debug] [Thread-2 (]: On model.nba_analytics.dim_dates: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_dates"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_dates__dbt_tmp
  
  
    as
  
  (
    

-- Get the min and max game dates from our source data






WITH date_spine AS (
    SELECT 
        generate_series::date as date_day
    FROM generate_series(
        '2002-10-29'::date,
        '2025-11-30'::date,
        '1 day'::interval
    )
)

SELECT
    -- Surrogate Key: An integer key in YYYYMMDD format
    CAST(to_char(date_day, 'YYYYMMDD') AS INTEGER) AS date_key,
    
    -- Date Attributes
    date_day AS full_date,
    EXTRACT(YEAR FROM date_day)::int AS year,
    EXTRACT(QUARTER FROM date_day)::int AS quarter_of_year,
    EXTRACT(MONTH FROM date_day)::int AS month_of_year,
    TRIM(to_char(date_day, 'Month')) AS month_name,
    EXTRACT(DAY FROM date_day)::int AS day_of_month,
    EXTRACT(ISODOW FROM date_day)::int AS day_of_week,
    TRIM(to_char(date_day, 'Day')) AS day_of_week_name,
    EXTRACT(DOY FROM date_day)::int AS day_of_year,
    EXTRACT(WEEK FROM date_day)::int AS week_of_year,
    CASE 
        WHEN EXTRACT(ISODOW FROM date_day) IN (6, 7) THEN true
        ELSE false 
    END AS is_weekend

FROM date_spine

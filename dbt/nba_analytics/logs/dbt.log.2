    FROM nba_analytics.analytics_dev_seeds.team_maps
)

SELECT
    -- Surrogate Key
    md5(cast(coalesce(cast(team_abbr as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS team_key,

    -- Team Identifiers
    team_abbr,
    full_name AS team_full_name

    -- We can add more dimensional attributes here in the future
    -- e.g., conference, division, city, etc.

FROM team_mappings
ORDER BY team_abbr
  );
  

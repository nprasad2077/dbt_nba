  create  table nba_analytics.analytics_dev_marts.fct_team_game_stats__dbt_tmp
  
  
    as
  
  (
    

WITH team_performance AS (
    SELECT *
    FROM nba_analytics.analytics_dev_intermediate.int_team_performance
),

game_details AS (
    SELECT
        game_id,
        game_date,
        season_start_year,
        home_team,
        visitor_team,
        arena AS arena_name,
        arena_city
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(tp.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(tp.team as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS team_game_key,

        -- Foreign Keys from Dimensions
        t.team_key,
        d.date_key,
        s.season_key,
        a.arena_key,
        opp.team_key AS opponent_key, -- Key for the opposing team

        -- Degenerate Dimension
        tp.game_id,

        -- Game Details
        -- BGN CHANGE: Deriving is_home_team directly from game_details
        (tp.team = gd.home_team) AS is_home_team,
        -- END CHANGE

        -- Measures from team_performance
        tp.points,
        tp.offensive_rating,
        tp.defensive_rating,
        tp.net_rating,
        tp.pace,
        tp.effective_fg_pct,
        tp.turnover_rate,
        tp.offensive_tier,
        tp.defensive_tier,

        -- Game Date for partitioning / incremental logic
        CAST(gd.game_date AS DATE) AS game_date

    FROM team_performance AS tp

    LEFT JOIN game_details AS gd
        ON tp.game_id = gd.game_id
    
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS t
        ON tp.team = t.team_abbr
    
    -- This join identifies the opponent's abbreviation for the opponent_key lookup
    -- BGN CHANGE: Corrected logic to derive opponent without the missing flag
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS opp
        ON CASE
            WHEN tp.team = gd.home_team THEN gd.visitor_team
            ELSE gd.home_team
        END = opp.team_abbr
    -- END CHANGE
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(gd.game_date AS DATE) = d.full_date
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON gd.season_start_year = s.season_start_year
        
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON gd.arena_name = a.arena_name AND gd.arena_city = a.arena_city

    
)

SELECT * FROM final
  );
  
  
[0m06:45:30.110053 [debug] [Thread-1 (]: On model.nba_analytics.fct_game_results: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.fct_game_results"} */

      
  
    

  create  table nba_analytics.analytics_dev_marts.fct_game_results__dbt_tmp
  
  
    as
  
  (
    

WITH games_enriched AS (
    SELECT *
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
    
)

SELECT
    -- Surrogate Key
    md5(cast(coalesce(cast(ge.game_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS game_key,

    -- Foreign Keys from Dimensions
    d.date_key,
    s.season_key,
    a.arena_key,
    home_team.team_key AS home_team_key,
    visitor_team.team_key AS visitor_team_key,
    winning_team.team_key AS winning_team_key,

    -- Degenerate Dimension
    ge.game_id,

    -- Core Outcome Measures & Context
    ge.home_points,
    ge.visitor_points,
    ge.point_differential,
    ge.total_points,
    ge.is_playoff,
    ge.is_overtime,
    CASE WHEN ge.home_points > ge.visitor_points THEN TRUE ELSE FALSE END AS is_home_team_winner,

    -- Matchup Performance Measures
    ge.home_net_rating,
    ge.visitor_net_rating,
    ge.matchup_pace,

    -- Derived Analytical Measures
    CASE
        WHEN ge.point_differential <= 5 THEN 'Clutch Game'
        WHEN ge.point_differential <= 10 THEN 'Competitive'
        WHEN ge.point_differential <= 20 THEN 'Decisive'
        ELSE 'Blowout'
    END AS game_competitiveness_tier,

    -- *** FIX: REMOVED is_potential_upset ***
    -- The upstream logic was flawed and always produced FALSE.
    -- This metric should be revisited if pre-game ranking/odds data becomes available.

    -- Game Date for partitioning / incremental logic
    CAST(ge.game_date AS DATE) AS game_date

FROM games_enriched AS ge

LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
    ON CAST(ge.game_date AS DATE) = d.full_date
LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
    ON ge.season_start_year = s.season_start_year
LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
    ON ge.arena = a.arena_name AND ge.arena_city = a.arena_city
LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS home_team
    ON ge.home_team = home_team.team_abbr
LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS visitor_team
    ON ge.visitor_team = visitor_team.team_abbr
LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS winning_team
    ON ge.winning_team = winning_team.team_abbr
  );
  
  

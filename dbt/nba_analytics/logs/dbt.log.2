  create  table nba_analytics.analytics_dev_marts.fct_game_results__dbt_tmp
  
  
    as
  
  (
    

WITH games_enriched AS (
    SELECT *
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
    
)

SELECT
    -- Surrogate Key
    md5(cast(coalesce(cast(ge.game_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS game_key,

    -- Foreign Keys from Dimensions
    d.date_key,
    s.season_key,
    a.arena_key,
    home_team.team_key AS home_team_key,
    visitor_team.team_key AS visitor_team_key,
    winning_team.team_key AS winning_team_key,

    -- Degenerate Dimension
    ge.game_id,

    -- Core Outcome Measures & Context
    ge.home_points,
    ge.visitor_points,
    ge.point_differential,
    ge.total_points,
    ge.is_playoff,
    ge.is_overtime,
    CASE WHEN ge.home_points > ge.visitor_points THEN TRUE ELSE FALSE END AS is_home_team_winner,

    -- Matchup Performance Measures
    ge.home_net_rating,
    ge.visitor_net_rating,
    ge.matchup_pace,

    -- Derived Analytical Measures
    CASE
        WHEN ge.point_differential <= 5 THEN 'Clutch Game'
        WHEN ge.point_differential <= 10 THEN 'Competitive'
        WHEN ge.point_differential <= 20 THEN 'Decisive'
        ELSE 'Blowout'
    END AS game_competitiveness_tier,

    -- *** FIX: REMOVED is_potential_upset ***
    -- The upstream logic was flawed and always produced FALSE.
    -- This metric should be revisited if pre-game ranking/odds data becomes available.

    -- Game Date for partitioning / incremental logic
    CAST(ge.game_date AS DATE) AS game_date

FROM games_enriched AS ge

LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
    ON CAST(ge.game_date AS DATE) = d.full_date
LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
    ON ge.season_start_year = s.season_start_year
LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
    ON ge.arena = a.arena_name AND ge.arena_city = a.arena_city
LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS home_team
    ON ge.home_team = home_team.team_abbr
LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS visitor_team
    ON ge.visitor_team = visitor_team.team_abbr
LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS winning_team
    ON ge.winning_team = winning_team.team_abbr
  );
  
  
[0m06:38:47.409335 [debug] [Thread-4 (]: On model.nba_analytics.fct_player_game_stats: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.fct_player_game_stats"} */

      
  
    

  create  table nba_analytics.analytics_dev_marts.fct_player_game_stats__dbt_tmp
  
  
    as
  
  (
    

WITH player_performance AS (
    SELECT * FROM nba_analytics.analytics_dev_intermediate.int_player_performance
),

game_details AS (
    SELECT
        game_id,
        arena AS arena_name,
        arena_city
    FROM nba_analytics.analytics_dev_intermediate.int_games_enriched
),

final AS (
    SELECT
        -- Surrogate Key
        md5(cast(coalesce(cast(pp.game_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(pp.player_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS player_game_key,

        -- Foreign Keys
        p.player_key,
        t.team_key,
        d.date_key,
        s.season_key,
        a.arena_key,
        
        -- Junk Dimension
        arch.archetype_key,

        -- Degenerate Dimension
        pp.game_id,

        -- Measures from player_performance
        pp.minutes_played,
        pp.points,
        pp.assists,
        pp.total_rebounds,
        pp.steals,
        pp.blocks,
        pp.turnovers,
        pp.plus_minus,
        pp.net_rating,
        pp.box_plus_minus,
        pp.field_goals_made,
        pp.field_goals_attempted,
        pp.three_pointers_made,
        pp.three_pointers_attempted,
        pp.true_shooting_pct,
        pp.effective_fg_pct,
        pp.usage_pct,
        pp.offensive_rating,
        pp.defensive_rating,

        -- Game Date for partitioning
        CAST(pp.game_date AS DATE) AS game_date

    FROM player_performance AS pp

    LEFT JOIN game_details AS gd
        ON pp.game_id = gd.game_id

    LEFT JOIN nba_analytics.analytics_dev_marts.dim_player_game_archetypes AS arch
        ON pp.usage_tier = arch.usage_tier
        AND pp.impact_tier = arch.impact_tier
        AND pp.shooting_efficiency_tier = arch.shooting_efficiency_tier
        AND pp.minutes_based_role = arch.minutes_based_role
        AND pp.is_double_double = arch.is_double_double
        AND pp.is_triple_double = arch.is_triple_double
        AND pp.is_versatile = arch.is_versatile
        AND pp.is_defensive_specialist = arch.is_defensive_specialist
        AND pp.is_three_and_d = arch.is_three_and_d
    
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_players AS p
        ON pp.player_id = p.player_id
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_teams AS t
        ON pp.team = t.team_abbr
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_dates AS d
        ON CAST(pp.game_date AS DATE) = d.full_date
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_seasons AS s
        ON pp.season_start_year = s.season_start_year
    -- This join is now robust and correct
    LEFT JOIN nba_analytics.analytics_dev_marts.dim_arenas AS a
        ON gd.arena_name = a.arena_name AND gd.arena_city = a.arena_city

    
)

SELECT * FROM final
  );
  
  

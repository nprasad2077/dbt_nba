[0m00:22:09.497569 [debug] [Thread-3 (]: On model.nba_analytics.dim_teams: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_teams"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_teams__dbt_tmp
  
  
    as
  
  (
    

WITH team_mappings AS (
    SELECT 
        team_abbr,
        full_name
    FROM nba_analytics.analytics_dev_seeds.team_maps
)

SELECT
    -- Surrogate Key
    md5(cast(coalesce(cast(team_abbr as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS team_key,

    -- Team Identifiers
    team_abbr,
    full_name AS team_full_name

    -- We can add more dimensional attributes here in the future
    -- e.g., conference, division, city, etc.

FROM team_mappings
ORDER BY team_abbr
  );
  
[0m00:22:09.497692 [debug] [Thread-1 (]: On model.nba_analytics.dim_arenas: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_arenas"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_arenas__dbt_tmp
  
  
    as
  
  (
    

WITH source AS (
    SELECT
        arena_name,
        city,
        state_or_country,
        location
    FROM nba_analytics.analytics_dev_seeds.arena_mappings
)

SELECT
    -- Surrogate Key: A unique key based on the combination of arena and city from our seed file
    md5(cast(coalesce(cast(arena_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS arena_key,

    -- Arena Attributes, renamed for clarity
    arena_name,
    city AS arena_city,
    state_or_country AS arena_state_or_country,
    location AS arena_location

FROM source
ORDER BY arena_name, arena_city
  );
  
[0m00:22:09.497880 [debug] [Thread-2 (]: On model.nba_analytics.dim_shot_zones: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_shot_zones"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_shot_zones__dbt_tmp
  
  
    as
  
  (
    



WITH zones AS (
    SELECT * FROM (
        VALUES
            ('At Rim (0-3 ft)',           0,  3,  1, 'Paint',      'Interior',    'Field Goal'),
            ('Short Range (4-10 ft)',     4,  10, 2, 'Paint',      'Interior',    'Field Goal'),
            ('Mid Range (11-16 ft)',      11, 16, 3, 'Mid Range',  'Mid Range',   'Field Goal'),
            ('Long Mid Range (17-23 ft)', 17, 23, 4, 'Mid Range',  'Mid Range',   'Field Goal'),
            ('Three Point (24-27 ft)',    24, 27, 5, 'Perimeter',  'Three Point', 'Field Goal'),
            ('Deep Three (28+ ft)',       28, 50, 6, 'Perimeter',  'Three Point', 'Field Goal'),
            ('Free Throw (15 ft)',        15, 15, 7, 'Free Throw', 'Free Throw',  'Free Throw')
    ) AS t(shot_distance_zone, min_distance_ft, max_distance_ft, zone_order, zone_group, zone_category, shot_class)
)

SELECT
    md5(cast(coalesce(cast(shot_distance_zone as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS shot_zone_key,
    shot_distance_zone,
    min_distance_ft,
    max_distance_ft,
    zone_order,
    zone_group,
    zone_category,
    shot_class
FROM zones
ORDER BY zone_order
  );
  

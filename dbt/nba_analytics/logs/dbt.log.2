[0m01:52:54.103093 [debug] [Thread-2 (]: On model.nba_analytics.dim_shot_zones: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_shot_zones"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_shot_zones__dbt_tmp
  
  
    as
  
  (
    



WITH zones AS (
    SELECT * FROM (
        VALUES
            ('At Rim (0-3 ft)',           0,  3,  1, 'Paint',      'Interior',    'Field Goal'),
            ('Short Range (4-10 ft)',     4,  10, 2, 'Paint',      'Interior',    'Field Goal'),
            ('Mid Range (11-16 ft)',      11, 16, 3, 'Mid Range',  'Mid Range',   'Field Goal'),
            ('Long Mid Range (17-23 ft)', 17, 23, 4, 'Mid Range',  'Mid Range',   'Field Goal'),
            ('Three Point (24-27 ft)',    24, 27, 5, 'Perimeter',  'Three Point', 'Field Goal'),
            ('Deep Three (28+ ft)',       28, 50, 6, 'Perimeter',  'Three Point', 'Field Goal'),
            ('Free Throw (15 ft)',        15, 15, 7, 'Free Throw', 'Free Throw',  'Free Throw')
    ) AS t(shot_distance_zone, min_distance_ft, max_distance_ft, zone_order, zone_group, zone_category, shot_class)
)

SELECT
    md5(cast(coalesce(cast(shot_distance_zone as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS shot_zone_key,
    shot_distance_zone,
    min_distance_ft,
    max_distance_ft,
    zone_order,
    zone_group,
    zone_category,
    shot_class
FROM zones
ORDER BY zone_order
  );
  

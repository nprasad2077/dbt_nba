    FROM nba_analytics.analytics_dev_intermediate.int_player_performance
)

SELECT
    md5(cast(coalesce(cast(usage_tier as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(impact_tier as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(shooting_efficiency_tier as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(minutes_based_role as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(is_double_double as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(is_triple_double as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(is_versatile as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(is_defensive_specialist as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(is_three_and_d as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS archetype_key,
    *
FROM distinct_archetypes
  );
  

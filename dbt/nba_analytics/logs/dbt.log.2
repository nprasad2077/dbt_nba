),

unpivoted_scores AS (
    -- This CTE unpivots the raw line scores data. The team abbreviations are still unconformed here.
    select
        game_id,
        team,
        total_points,
        first_half_points,
        second_half_points,
        regulation_points,
        overtime_points,
        had_ot1,

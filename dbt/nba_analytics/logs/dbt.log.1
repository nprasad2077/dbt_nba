  create  table nba_analytics.analytics_dev_test_results.relationships_int_games_enrich_2bcced32fda94048e3833239649c6bec
  
  
    as
  
  (
    
    
  
    
    

with child as (
    select visitor_team as from_field
    from nba_analytics.analytics_dev_intermediate.int_games_enriched
    where visitor_team is not null
),

parent as (
    select team as to_field
    from nba_analytics.analytics_dev_intermediate.int_team_performance
)

select
    from_field

from child
left join parent
    on child.from_field = parent.to_field

where parent.to_field is null



  
  
  );
  
    

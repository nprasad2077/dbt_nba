  create  table nba_analytics.analytics_dev_marts.dim_teams__dbt_tmp
  
  
    as
  
  (
    

WITH team_mappings AS (
    SELECT 
        team_abbr,
        full_name
    FROM nba_analytics.analytics_dev_seeds.team_maps
)

SELECT
    -- Surrogate Key
    md5(cast(coalesce(cast(team_abbr as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS team_key,

    -- Team Identifiers
    team_abbr,
    full_name AS team_full_name

    -- We can add more dimensional attributes here in the future
    -- e.g., conference, division, city, etc.

FROM team_mappings
ORDER BY team_abbr
  );
  
[0m00:02:23.732039 [debug] [Thread-1 (]: On model.nba_analytics.dim_arenas: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.dim_arenas"} */

  
    

  create  table nba_analytics.analytics_dev_marts.dim_arenas__dbt_tmp
  
  
    as
  
  (
    

WITH source AS (
    SELECT
        arena_name,
        city,
        state_or_country,
        location
    FROM nba_analytics.analytics_dev_seeds.arena_mappings
)

SELECT
    -- Surrogate Key: A unique key based on the combination of arena and city from our seed file
    md5(cast(coalesce(cast(arena_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS arena_key,

    -- Arena Attributes, renamed for clarity
    arena_name,
    city AS arena_city,
    state_or_country AS arena_state_or_country,
    location AS arena_location

FROM source
ORDER BY arena_name, arena_city
  );
  

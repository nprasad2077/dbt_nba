        q4_momentum,
        max_quarter_score,
        min_quarter_score,
        best_quarter,
        created_at,
        updated_at,
        dbt_loaded_at,

      cast('q3_points' as TEXT) as period_name,
      cast(  
           q3_points
             
           as INTEGER) as points_scored

    from nba_analytics.analytics_dev_staging.stg_line_scores

    union all
    select
        game_id,
        team,
        total_points,
        first_half_points,
        second_half_points,
        regulation_points,
        overtime_points,
        had_ot1,
        had_ot2,

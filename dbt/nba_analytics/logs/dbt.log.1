[0m01:05:00.432832 [debug] [Thread-4 (]: On model.nba_analytics.stg_player_game_adv_stats: /* {"app": "dbt", "dbt_version": "1.10.13", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics.stg_player_game_adv_stats"} */

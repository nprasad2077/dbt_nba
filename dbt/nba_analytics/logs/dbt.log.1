    as
  
  (
    

WITH distinct_archetypes AS (
    SELECT DISTINCT
        usage_tier,
        impact_tier,
        shooting_efficiency_tier,
        minutes_based_role,
        is_double_double,
        is_triple_double,
        is_versatile,
        is_defensive_specialist,

  create  table nba_analytics.analytics_dev_marts.dim_arenas__dbt_tmp
  
  
    as
  
  (
    

WITH source AS (
    SELECT
        arena_name,
        city,
        state_or_country,
        location
    FROM nba_analytics.analytics_dev_seeds.arena_mappings
)

SELECT
    -- Surrogate Key: A unique key based on the combination of arena and city from our seed file
    md5(cast(coalesce(cast(arena_name as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(city as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS arena_key,

    -- Arena Attributes, renamed for clarity
    arena_name,
    city AS arena_city,
    state_or_country AS arena_state_or_country,
    location AS arena_location

FROM source
ORDER BY arena_name, arena_city
  );
  

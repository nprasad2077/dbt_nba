        se.shot_x_coordinate,
        se.shot_y_coordinate,

        -- Shot Outcome Measures
        se.is_made,
        se.shot_made_flag,
        se.shot_missed_flag,

        -- Shot Type Measures
        se.shot_type_raw AS shot_type,
        se.shot_point_value,
        se.is_three_pointer,
        se.is_free_throw,
        se.distance_ft,
        se.shot_distance_zone,
        se.points_generated,

